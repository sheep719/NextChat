# 复制为 .env 并填入真实值（本文件只留空键名，不含任何密钥）
PORT=3600
HOST=127.0.0.1
UPSTREAM_TIMEOUT_MS=600000

# ===== 统一鉴权 =====
# 凭证模式：apikey | jwt | both
AUTH_MODE=both
# API Key 注册表，格式 <key>[:<clientId>]，多条用逗号分隔
GATEWAY_API_KEYS=
# JWT 密钥（HS256）；留空则关闭 JWT 能力
JWT_SECRET=
JWT_ALGS=HS256
JWT_ISSUER=nextchat-gateway
JWT_AUDIENCE=
JWT_DEFAULT_TTL_SEC=3600
JWT_MAX_TTL_SEC=43200
JWT_CLOCK_SKEW_SEC=60
# 是否允许匿名访问（默认 false，未授权即拒绝）
ALLOW_ANONYMOUS=false
# 浏览器直连（NextChat 自定义 endpoint）时的跨域来源白名单
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===== 用户体系（SQLite） =====
DB_PATH=data/gateway.db
CHAT_REQUIRE_USER=true
REGISTRATION_ENABLED=true
USER_TOKEN_TTL_SEC=7200

# ===== 上游 provider =====
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
